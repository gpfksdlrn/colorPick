{
  "name": "colorpick",
  "version": "1.0.0",
  "description": "화면 어디서든 색상을 추출하는 데스크탑 툴",
  "author": "Hyeran Mun",
  "main": "src/main.js",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --publish never"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "screenshot-desktop": "^1.15.4"
  },
  "patchedDependencies": {
    "screenshot-desktop@1.15.4": "patches/screenshot-desktop@1.15.4.patch"
  },
  "build": {
    "appId": "com.yourname.colorpick",
    "productName": "ColorPick",
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg",
      "icon": "assets/icon.icns",
      "identity": null,
      "artifactName": "ColorPick-mac.dmg",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "색상 추출을 위해 화면 녹화 권한이 필요합니다."
      }
    },
    "asarUnpack": [
      "assets/tray-iconTemplate.png",
      "assets/tray-iconTemplate@2x.png",
      "node_modules/screenshot-desktop/lib/win32/**",
      "resources/win-color-correct.ps1"
    ],
    "files": [
      "src/*.js",
      "renderer/*.html",
      "resources/win-color-correct.ps1",
      "assets/icon.{icns,ico}",
      "assets/tray-iconTemplate*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "artifactName": "ColorPick-win.exe"
    },
    "publish": null
  }
}
